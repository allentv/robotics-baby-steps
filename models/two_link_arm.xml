<mujoco model="two_link_arm">
  <option timestep="0.002"/>
  <worldbody>
    <geom type="plane" size="2 2 0.1" rgba="0.9 0.9 0.9 1"/>
    <body name="link1" pos="0 0 0.05">
      <joint name="joint1" type="hinge" axis="0 0 1" damping="0.05" limited="true" range="-3.14 3.14"/>
      <geom type="capsule" fromto="0 0 0 0.4 0 0" size="0.03" mass="1.0" rgba="0.2 0.5 0.9 1"/>
      <body name="link2" pos="0.4 0 0">
        <joint name="joint2" type="hinge" axis="0 0 1" damping="0.05" limited="true" range="-2.6 2.6"/>
        <geom type="capsule" fromto="0 0 0 0.3 0 0" size="0.025" mass="0.8" rgba="0.9 0.5 0.2 1"/>
        <site name="tip" pos="0.3 0 0" size="0.02" rgba="0.1 0.8 0.3 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="shoulder" joint="joint1" ctrlrange="-5 5" ctrllimited="true"/>
    <motor name="elbow" joint="joint2" ctrlrange="-5 5" ctrllimited="true"/>
  </actuator>
</mujoco>
